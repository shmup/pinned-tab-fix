{

  "manifest_version": 2,
  "name": "Pinned Tab Fix",
  "version": "2.4.1",

  "description": "moves new tabs opened from a pinned tab to the right end of the tab bar",
  "homepage_url": "https://github.com/shmup/pinned-tab-fix",
  "default_locale": "en",

  "browser_specific_settings": {
    "gecko": {
      "id": "@pinned-tab-fix",
      "strict_min_version": "61.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },

  "background": {
    "scripts": ["background-script.js"]
  },

  "options_ui": {
      "page": "options/options.html"
  },

  "permissions": [
    "storage"
  ]

}
